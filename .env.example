# =============================================================
# TYPEFAST ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================

# PostgreSQL Database Connection
DATABASE_URL=postgresql://typefast_user:your_secure_password@localhost:5432/typefast_production

# JWT Authentication Secret
AUTH_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Frontend API URL
API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

# Server Port
PORT=4000
NODE_ENV=development
